{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loofi.dev/supportkit/schemas/evidence.schema.json",
  "title": "SupportKit evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "collectorId", "kind", "collectedAt", "data"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "collectorId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
    "collectedAt": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  }
}

