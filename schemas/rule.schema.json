{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loofi.dev/supportkit/schemas/rule.schema.json",
  "title": "SupportKit declarative diagnostic rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "platforms",
    "categories",
    "title",
    "severity",
    "confidence",
    "explanation",
    "collectorId",
    "condition",
    "likelyImpact",
    "recommendedNextSteps",
    "documentationLinks"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "version": { "type": "integer", "minimum": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["windows_11_x64", "fedora_kde_44_x64"] }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "performance",
          "network",
          "updates",
          "storage",
          "drivers_graphics",
          "services",
          "general"
        ]
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["critical", "warning", "notice", "info"] },
    "confidence": {
      "enum": [
        "confirmed_problem",
        "strong_indicator",
        "possible_cause",
        "informational_observation"
      ]
    },
    "explanation": { "type": "string", "minLength": 1 },
    "collectorId": { "type": "string" },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator", "value"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "greater_than",
            "greater_or_equal",
            "less_than",
            "contains",
            "exists"
          ]
        },
        "value": {}
      }
    },
    "likelyImpact": { "type": "string", "minLength": 1 },
    "recommendedNextSteps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "documentationLinks": {
      "type": "array",
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    }
  }
}
